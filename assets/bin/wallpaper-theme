#!/bin/sh

# wallpaper-theme — apply a wallpaper plus a palette generated from it.
# Called by the quickshell wallpaper picker, which does the color extraction
# (Canvas histogram) and passes the derived palette in.
#
# usage: wallpaper-theme <image> <bg> <altbg> <fg> <border> <primary> <secondary> <alert> <disabled> <ansi0..15>

set -u

[ $# -eq 25 ] || {
    echo "usage: wallpaper-theme <image> <8 semantic colors> <16 ansi colors>" >&2
    exit 1
}

CONFIG_DIR="/home/waltz/.config"
CACHE_DIR="$CONFIG_DIR/../.cache/wallpaper-theme"

IMG="$1" BG="$2" ALTBG="$3" FG="$4" BORDER="$5"
PRIMARY="$6" SECONDARY="$7" ALERT="$8" DISABLED="$9"

shift 9  # $1..$16 are now the ANSI terminal colors

[ -f "$IMG" ] || {
    echo "no such wallpaper: $IMG" >&2
    exit 1
}

mkdir -p "$CACHE_DIR" "$CONFIG_DIR/../.cache" "$CONFIG_DIR/../.local/state"

# Serialize concurrent runs — the last pick wins whole. Spawned daemons
# must not inherit fd 9 or the lock outlives the script.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/wallpaper-theme.lock"
flock -w 60 9 || echo "wallpaper-theme: lock timeout, proceeding unlocked" >&2

# 1. Polybar/quickshell palette — Theme.qml watches this file and re-colors
#    the bar live the moment it lands.
cat > "$CONFIG_DIR/../.local/state/colors.ini" <<EOF
[colors]
background-alt = $ALTBG
foreground = $FG
primary = $PRIMARY
secondary = $SECONDARY
alert = $ALERT
disabled = $DISABLED
border = $BORDER
EOF

# 2. Alacritty — session-local config dir; live config reload.
#    ~/.config/alacritty is left alone.
cat > "$CACHE_DIR/current-theme.toml" <<EOF
# Generated by wallpaper-theme
# Wallpaper: $(basename "$IMG")

[colors.primary]
foreground = "$FG"
background = "$BG"

[colors.cursor]
text = "$BG"
cursor = "$FG"

[colors.selection]
text = "$FG"
background = "$ALTBG"

[colors.normal]
black   = "$1"
red     = "$2"
green   = "$3"
yellow  = "$4"
blue    = "$5"
magenta = "$6"
cyan    = "$7"
white   = "$8"

[colors.bright]
black   = "$9"
red     = "${10}"
green   = "${11}"
yellow  = "${12}"
blue    = "${13}"
magenta = "${14}"
cyan    = "${15}"
white   = "${16}"
EOF

# 5. Umbriel — generate colors.toml
UMBriel_DIR="$CONFIG_DIR/umbriel/cfg"
mkdir -p "$UMBriel_DIR"

cat > "$UMBriel_DIR/colors.toml" <<EOF
# Colors
[colors.border]
focused = "${BORDER}FF"
unfocused = "${ALTBG}FF"
outer = "${BG}FF"

[colors]
backdrop = "${BG}00"
shadow = "#000000FF"
EOF

# 3. Ghostty — native config format; live config reload.
#    Imported by the Ghostty wrapper's config-file setting.
cat > "$CACHE_DIR/current-theme.ghostty" <<EOF
# Generated by wallpaper-theme
# Wallpaper: $(basename "$IMG")

background = "#060706"
foreground = $FG

cursor-color = $FG
cursor-text = $BG

selection-background = $ALTBG
selection-foreground = $FG

palette = 0=$1
palette = 1=$2
palette = 2=$3
palette = 3=$4
palette = 4=$5
palette = 5=$6
palette = 6=$7
palette = 7=$8
palette = 8=$9
palette = 9=${10}
palette = 10=${11}
palette = 11=${12}
palette = 12=${13}
palette = 13=${14}
palette = 14=${15}
palette = 15=${16}
EOF

# 4. Wallpaper now — awww animates the change (the daemon is started by
#    config.conf's exec-once; started here too in case it isn't running).
pgrep -x awww-daemon >/dev/null 2>&1 ||
    { awww-daemon >/dev/null 2>&1 9>&- & sleep 0.5; }

awww img "$IMG" --resize crop --transition-type wipe --transition-angle 30 \
    --transition-fps 60 --transition-duration 1 >/dev/null 2>&1 || true

# Persist the wallpaper for the next login.
sed -i "s|^exec-once=awww img .*|exec-once=awww img /home/waltz/.local/share/wallpapers/$(basename "$IMG") --resize crop|" \
    "$CONFIG_DIR/config.conf"

echo "$IMG" > "$HOME/.cache/mango/current_wallpaper"

"/home/waltz/.local/bin/mango-reload" >/dev/null 2>&1 || true

sleep 0.5
notify-send -a "Wallpaper" -t 2500 \
    "Wallpaper theme" "Palette from $(basename "$IMG")"

pkill -USR2 -x ghostty

