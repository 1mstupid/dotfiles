(defcfg
  input  (device-file "/dev/input/by-id/usb-SEMICO_USB_Gaming_Keyboard-event-kbd")
  output (uinput-sink "kmonad output")
  fallthrough true
)

(defsrc
  q w e r t y u i o p
  a s d f g h j k l ;
  z x c v b n m , . /
  spc
)

(defalias
  ;; Homerow mods
  a_ctl (tap-hold-next-release 200 a lmet)
  s_alt (tap-hold-next-release 200 s lalt)
  d_gui (tap-hold-next-release 200 d lctl)
  f_sft (tap-hold-next-release 200 f lsft)

  j_sft (tap-hold-next-release 200 j rsft)
  k_gui (tap-hold-next-release 200 k rctl)
  l_alt (tap-hold-next-release 200 l lalt)
  scl_ctl (tap-hold-next-release 200 ; rmet)

  ;; FIXED: Changed tap-dance to multi-tap and fixed the syntax
  q_esc (multi-tap 200 q esc)       ;; Tap once for Q, twice for Escape
  sl_bs (multi-tap 200 / del)      ;; Tap once for /, twice for Backspace

  ;; Layer toggle on Space
  spc_nav (tap-hold-next-release 200 spc (layer-toggle nav))
)

(deflayer base
  @q_esc w   e   r   t   y   u      i      o      p
  @a_ctl @s_alt @d_gui @f_sft g h @j_sft @k_gui @l_alt @scl_ctl
  z      x   c   v   b   n   m      ,      .      @sl_bs
  @spc_nav
)

(deflayer nav
  _    _    _    _    _    _    bspc home end  esc
  _    _    _    _    _    left down up   rght bspc
  _    _    _    _    _    _    caps pgdn pgup  _
  _
)
