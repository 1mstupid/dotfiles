(defwidget task-item [task]
  (box :class "task-item ${task.priority == "" ? "none" : task.priority} ${task.active == "true" ? "active" : ""}"
       :orientation "h"
       :space-evenly false
       :halign "fill"
    
    (box :class "priority-indicator")

    (box :class "task-content"
         :orientation "v"
         :hexpand true
         :halign "start"
      (label :class "task-desc" 
             :text "${task.id}. ${task.description}"
             :wrap false)
      (label :class "task-meta"
             :text "${task.project == "" ? "no project" : task.project} • ${task.due == "" ? "no due date" : task.due} • ${task.active == "true" ? "▶ active" : ""}"))

    (box :class "task-actions"
         :orientation "h"
         :space-evenly false
      (button :class "btn-done"
              :onclick "task ${task.id} done"
        "")
      ;; FIXED: Use task.active which is always "true" or "false"
      (button :class "${task.active == "true" ? "btn-stop" : "btn-start"}"
              :onclick "${task.active == "true" ? "task " + task.id + " stop" : "~/.config/eww/scripts/task-start start " + task.id}"
        {task.active == "true" ? "⏹" : "▶"}))))
