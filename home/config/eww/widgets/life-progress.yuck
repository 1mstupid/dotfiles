(defvar life-manual-hidden "false")
(defwidget life-progress []
  (box :class "life-progress-container"
  :visible {workspace-empty == "true" && life-manual-hidden == "false"}
  (box
      :orientation "v"
      :class "life-progress-full"
      :space-evenly false
      :spacing 16
      :visible {workspace-empty == "true" && life-manual-hidden == "false"}

      (box
        :orientation "h"
        :space-evenly false
        :spacing 8
        (box :hexpand true))

      (label
        :class "dot-grid"
        :text "${life.grid}"
        :wrap true)

      (box
        :orientation "h"
        :space-evenly false
        :halign "center"
        (box :hexpand true)
        (label :class "days-left" :text "${life.days_left} days left" )))
        )
  )
