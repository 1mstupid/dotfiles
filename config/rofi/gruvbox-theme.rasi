* {
    bg:         #000000;
    bg-alt:     #000000;
    fg:         #ffffff;
    fg-dim:     #ffffff;

    accent:     #ffffff;
    urgent:     #ffffff;

    background-color: @bg;
    text-color: @fg;

    border: 0;
    spacing: 0;
}

window {
    width: 18%;
    location: center;
    anchor: center;

    background-color: @bg;

    border: 2px;
    border-color: @bg-alt;
    border-radius: 5;

    padding: 8px;
}

mainbox {
    spacing: 6px;
    children: [ inputbar, listview ];
}

inputbar {
    children: [ prompt, entry ];
    background-color: transparent;

    padding: 0 0 6px 0;

    border: 0 0 1px 0;
    border-color: @bg-alt;
}

prompt {
    text-color: @accent;
    padding: 0 8px 0 0;
}

entry {
    expand: true;
    placeholder: "Search";
    placeholder-color: @fg-dim;
}

listview {
    columns: 1;
    lines: 10;

    layout: vertical;

    dynamic: true;
    cycle: true;
    scrollbar: false;

    spacing: 0;
    border: 0;
    padding: 0;
}

element {
    padding: 5px 8px;

    border: 0;
    border-radius: 0;

    background-color: transparent;
    text-color: @fg;
}

element normal.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @bg;
}

element-text selected.normal {
    text-color: @accent;
}

element selected.active {
    background-color: @accent;
    text-color: @bg;
}

element selected.urgent {
    background-color: @urgent;
    text-color: @bg;
}

element-icon {
    enabled: false;
    size: 0px;
}

element-text {
    horizontal-align: 0;
    vertical-align: 0.5;
}

mode-switcher {
    enabled: false;
}

message {
    enabled: false;
}
