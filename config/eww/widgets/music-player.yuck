(defvar liked       false)
(defvar muted       false)

(defwidget cover-thumb []
  (box
    :class "cover-thumb"
    :halign "center"
    :valign "center"
    :hexpand false
    (image
      :path song-cover 
      :image-width  80
      :image-height 80
      :class "album-art"
    )))

(defwidget track-info []
  (box
    :orientation "v"
    :spacing 2
    :valign "center"
    :space-evenly false
    (label :text song-title :class "player-title" :halign "start")
    (label :text "${song-year}" :class "player-meta-1"  :halign "start")
    (label :text "${song-artist}" :class "player-meta-0"  :halign "start")))

(defwidget transport []
  (box
    :orientation ""
    :spacing 6
    :valign "center"
    :space-evenly false
    (eventbox :onclick "scripts/prev.sh" :cursor "pointer"
      (label :text "󰒮" :class "icon-btn"))
    (eventbox :onclick "scripts/toggle-play.sh" :cursor "pointer"
      (box :class "play-btn"
        (label :text {playing ? "" : ""} :class "play-icon")))
    (eventbox :onclick "scripts/next.sh" :cursor "pointer"
      (label :text "󰒭" :class "icon-btn"))
    (eventbox
        :onclick "scripts/toggle-mute.sh"
        :cursor  "pointer"
        (label
          :text  {muted ? "󰝟" : "󰕾"}
          :class {muted ? "icon-btn active" : "icon-btn"}))
    (eventbox
        :onclick "scripts/toggle-like.sh"
        :cursor  "pointer"
        (label
          :text  {liked ? "󰓎" : "󰓒"}
          :class {liked ? "icon-btn active" : "icon-btn"}))
          ))

(defwidget player-progress []
  (scale
    :class       "progress-bar player-progress"
    :value       progress
    :min         0
    :max         100
    :orientation "h"
    :hexpand     false
    :onchange    "scripts/seek.sh {}"))

(defwidget mute-btn []
  (eventbox
    :onclick "scripts/toggle-like.sh"
    :cursor  "pointer"
    (label
      :text  {liked ? "" : ""}
      :class {liked ? "icon-btn active" : "icon-btn"})))
(defwidget track-block []
  (box
    :orientation "v"
    :spacing 6
    :valign "center"
    :space-evenly false
    (track-info)
    (box
      :orientation "h"
      :spacing 8
      :valign "center"
      :space-evenly false
      (transport)
      )))

(defwidget seconds-bar []
  (scale
    :class       "seconds-bar"
    :value       clock-progress
    :min         0
    :max         100
    :orientation "h"
    :hexpand     true))

(defwidget cal-day [short full date active distance]
  (box
    :orientation "v"
    :spacing 0
    :class {
      active        ? "cal-day-col active" :
      distance == 1 ? "cal-day-col near"   :
      distance == 2 ? "cal-day-col mid"    :
                      "cal-day-col far"
    }
    :halign "center"
    :valign "center"
    (label :text {active ? full : short} :class "cal-day-label")
    (label :text date                    :class "cal-day-num")))

(defwidget clock-block []
  (box
    :orientation "v"
    :spacing 2
    :halign "end"
    :valign "center"
    :space-evenly false
    (label :text clock-time :class "clock-time")
    (box
      :orientation "h"
      :spacing 0
      :halign "center"
      :space-evenly false
      (cal-day :short {clock-week-labels-short[0]} :full {clock-week-labels-full[0]} :date {clock-week-dates[0]} :active {clock-days[0]} :distance 3)
      (cal-day :short {clock-week-labels-short[1]} :full {clock-week-labels-full[1]} :date {clock-week-dates[1]} :active {clock-days[1]} :distance 2)
      (cal-day :short {clock-week-labels-short[2]} :full {clock-week-labels-full[2]} :date {clock-week-dates[2]} :active {clock-days[2]} :distance 1)
      (cal-day :short {clock-week-labels-short[3]} :full {clock-week-labels-full[3]} :date {clock-week-dates[3]} :active {clock-days[3]} :distance 0)
      (cal-day :short {clock-week-labels-short[4]} :full {clock-week-labels-full[4]} :date {clock-week-dates[4]} :active {clock-days[4]} :distance 1)
      (cal-day :short {clock-week-labels-short[5]} :full {clock-week-labels-full[5]} :date {clock-week-dates[5]} :active {clock-days[5]} :distance 2)
      (cal-day :short {clock-week-labels-short[6]} :full {clock-week-labels-full[6]} :date {clock-week-dates[6]} :active {clock-days[6]} :distance 3))))

(defwidget music-player []
  (box
    :class       "widget-card player-card"
    :orientation "h"
    :spacing     12
    :valign      "center"
    :space-evenly false
    (cover-thumb)
    (track-block)
    (box :hexpand true)
    (clock-block)))
