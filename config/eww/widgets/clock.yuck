(defvar clock-manual-hidden "false")
(defwidget clock []
  (box
     :class "clock-container"
     :orientation "v"
     :space-evenly false
     :halign "center"
     :valign "center"
     :visible {workspace-empty == "true" && clock-manual-hidden == "false"}
    (box :class "clock-full"
      :orientation "v"
      :space-evenly false
      :spacing 8
      (label :class "clock-time" :text "${clock.time}")
      (label :class "clock-date" :text "${clock.date}")
      (scale
        :class "clock-scale"
        :value "${clock.progress}"
        :min 0
        :max 100
        :orientation "h"
        :hexpand true))
      )
  )
