;; eww.yuck
(defvar music_expanded false)
(include "/home/waltz/.config/eww/widgets/music-player.yuck")
(include "/home/waltz/.config/eww/windows/music-player.yuck")

(defwindow main
  :monitor 0
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "100%")
  :stacking "bg"
  :exclusive false
  :focusable false
  :stylesheet "./eww.scss"
  (box))


; Playing state — reacts instantly via playerctl --follow
(deflisten playing :initial "false"
  `scripts/listen-status.sh`)

; Track metadata — polled every 2 s
(defpoll song-title :interval "2s" :initial "Not Playing"
  `playerctl --player=chromium,chrome,firefox,brave,%any metadata title 2>/dev/null || echo "Not Playing"`)

(defpoll song-artist :interval "2s" :initial ""
  `playerctl --player=chromium,chrome,firefox,brave,%any metadata artist 2>/dev/null || echo ""`)

; Holds album / playlist name (YT Music exposes this as the album field)
(defpoll song-year :interval "2s" :initial ""
  `playerctl --player=chromium,chrome,firefox,brave,%any metadata album 2>/dev/null || echo ""`)

; Cover art — downloads artUrl to /tmp, returns local file path
(defpoll song-cover :interval "3s" :initial ""
  `scripts/get-cover.sh`)

; Playback position formatted as m:ss, polled every second
(defpoll current-time :interval "1s" :initial "0:00"
  `playerctl --player=chromium,chrome,firefox,brave,%any position 2>/dev/null \
   | awk '{m=int($1/60); s=int($1%60); printf "%d:%02d\n", m, s}' || echo "0:00"`)

; Track duration formatted as m:ss, polled every 5 s (doesn't change mid-track)
(defpoll total-time :interval "5s" :initial "0:00"
  `playerctl --player=chromium,chrome,firefox,brave,%any metadata mpris:length 2>/dev/null \
   | awk '{m=int($1/1000000/60); s=int($1/1000000%60); printf "%d:%02d\n", m, s}' || echo "0:00"`)

; Progress percentage 0-100
(defpoll progress :interval "1s" :initial 0
  `scripts/get-progress.sh`)

; System volume from the default PulseAudio / PipeWire sink
(defpoll volume :interval "2s" :initial 66
  `pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\d+(?=%)' | head -1 || echo "50"`)

; Repeat state — true when playerctl loop is Track or Playlist
(defpoll repeat-on :interval "2s" :initial "false"
  `playerctl --player=chromium,chrome,firefox,brave,%any loop 2>/dev/null \
   | grep -q "Track\|Playlist" && echo "true" || echo "false"`)

; Shuffle state
(defpoll shuffle-on :interval "2s" :initial "false"
  `playerctl --player=chromium,chrome,firefox,brave,%any shuffle 2>/dev/null \
   | grep -qi "^On$" && echo "true" || echo "false"`)


;  Window 
(defpoll clock-time       :interval "1s" "scripts/clock.sh | jq -r '.[\"clock-time\"]'"       )
(defpoll clock-progress   :interval "1s" "scripts/clock.sh | jq -r '.[\"clock-progress\"]'"   )
(defpoll clock-days       :interval "10s" "scripts/clock.sh | jq '.[\"clock-days\"]'"         )
(defpoll clock-week-dates :interval "10s" "scripts/clock.sh | jq '.[\"clock-week-dates\"]'"   )
(defpoll clock-week-labels-full :interval "10s" "scripts/clock.sh | jq '.[\"clock-week-labels-full\"]'"   )
(defpoll clock-week-labels-short :interval "10s" "scripts/clock.sh | jq '.[\"clock-week-labels-short\"]'"   )




;; Window definition
(defwindow border-overlay
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "100%"
                      :anchor "center")
  :stacking "overlay"
  :focusable false
  :exclusive false
  (border-widget))


;; Widget definition
(defwidget border-widget []
  (box :class "border-container"
       :orientation "vertical"
       :space-evenly false
       :valign "fill"
       :halign "fill"
    (box :class "border-inner"
         :orientation "vertical"
         :space-evenly false
         :valign "fill"
         :halign "fill"
         :hexpand true
         :vexpand true
      "")))

(defwindow border-corners
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "100%"
                      :anchor "center")
  :stacking "overlay"
  :focusable false
  :exclusive false
  (border-corners))


;; Widget definition
(defwidget border-corners []
  (box :class "corner-container"
       :orientation "vertical"
       :space-evenly false
       :valign "fill"
       :halign "fill"
    (box :class "corner-inner"
         :orientation "vertical"
         :space-evenly false
         :valign "fill"
         :halign "fill"
         :hexpand true
         :vexpand true
      "")))
;; Top-center dock
;; ── 1. TOP DOCK (thin hover trigger) ──
(defwindow music-dock
  :monitor 0
  :geometry (geometry :x "0%" :y "0%" :width "400px" :height "10px" :anchor "top center")
  :stacking "overlay"
  :reserve (struts :distance "50px" :side "top")
  :focusable false
  :exclusive false
  (eventbox
    :class "music-hover-zone"
    :onhover "scripts/music-popup.sh open"
    :onhoverlost "scripts/music-popup.sh close"
    (box
      :orientation "h"
      :halign "center"
      :valign "start"
      :space-evenly false
      (image :class "dock-ear" :path "ear-left.svg" :image-width 30 :image-height 100)
      (box
        :class "music-dock-inner"
        :orientation "v"
        :halign "center"
        :valign "start"
        :space-evenly false
        (label :text clock-time :class "nudge-time"))
      (image :class "dock-ear" :path "ear-right.svg" :image-width 30 :image-height 100))))

(defwindow music-popup
  :monitor 0
  :geometry (geometry :x "0%" :y "-90px" :width "280px" :anchor "top center")
  :stacking "overlay"
  :focusable false
  :exclusive false
  (eventbox
    :class "popup-hover-zone"
    :onhover "scripts/music-popup.sh open"
    :onhoverlost "scripts/music-popup.sh close"
    (box
        :orientation "v"
        :halign "center"
        :valign "start"
        :space-evenly false
      (box
      :class "popup-card"
      :orientation "h"
      :halign "center"
      :valign "start"
      :space-evenly false
      (image :class "dock-ear" :path "ear-left.svg" :image-width 298 :image-height 298)
      (music-player)
      (image :class "dock-ear" :path "ear-right.svg" :image-width 298 :image-height 298)
      ))))
