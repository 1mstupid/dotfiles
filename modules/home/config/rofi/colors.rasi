/* Generated from wallpaper: cute-anime-girl-with-bird-art-desktop-wallpaper.jpg */

* {
    bg:          #20372c;
    fg:          #d2cfbc;
    accent:      #99e1be;
    accent-2:    #e0c8b8;
    border:      #99e1be;
    urgent:      #cf9681;
    selected-fg: #d2cfbc;
    entry-fg:    #e0c8b8;
    prompt-fg:   #99e1be;
    header:      #e0c8b8;

    background-color: @bg;
}
