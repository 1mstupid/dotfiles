* {
    bg:          #1b1317;
    fg:          #d2cbbc;
    accent:      #a3dcd2;
    accent-2:    #5b7ec8;
    border:      #a3dcd2;
    urgent:      #c06767;
    selected-fg: #d2cbbc;
