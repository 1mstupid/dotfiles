/* Generated from wallpaper: my-neighbor-totoro-sunflowers.png */

* {
    bg:          #213f45CC;
    fg:          #d2ccbc;
    accent:      #11b5d4;
    active:      #ead9ae;
    border:      #11b5d4;
    urgent:      #d19894;
    selected-bg: #213f45;
    selected-fg: #d2ccbc;
    entry-fg:    #ead9ae;
    prompt-fg:   #11b5d4;
    header:      #ead9ae;

    background-color: @bg;
}
