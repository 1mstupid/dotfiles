/* Generated from wallpaper: wallpaperflare.com_wallpaper(3).jpg */

* {
    bg:          #171717CC;
    fg:          #d2cbbc;
    accent:      #bea7a7;
    active:      #c4beb6;
    border:      #bea7a7;
    urgent:      #cb8a86;
    selected-bg: #171717;
    selected-fg: #d2cbbc;
    entry-fg:    #c4beb6;
    prompt-fg:   #bea7a7;
    header:      #c4beb6;

    background-color: @bg;
}
