* {
    bg:          #243129CC;
    fg:          #d2cbbc;
    accent:      #81bb9b;
    active:      #afcacb;
    border:      #81bb9b;
    urgent:      #cb8a86;
    selected-bg: #243129;
    selected-fg: #d2cbbc;
    entry-fg:    #afcacb;
    prompt-fg:   #81bb9b;
    header:      #afcacb;

    background-color: @bg;
}
