#!/usr/bin/env bash

set -e

OUTPUT_DIR="$HOME/Videos/recordings"
mkdir -p "$OUTPUT_DIR"

FILE="$OUTPUT_DIR/recording-$(date '+%Y-%m-%d_%H-%M-%S').mp4"

# Get the current default output sink.
SINK="$(pactl get-default-sink)"

# Capture the monitor of that sink (i.e. exactly what you hear).
MONITOR="${SINK}.monitor"

echo "Output sink:  $SINK"
echo "Audio source: $MONITOR"
echo "Output file:  $FILE"
echo
echo "Recording... Press Ctrl+C to stop."

wf-recorder \
    -a"$MONITOR" \
    -f "$FILE"
